+    /// Owned narration callback: generation and decoding remain on the caller's
+    /// task. A throwing consumer stops generation and runs decoder-state cleanup.
+    /// The public AsyncThrowingStream convenience API remains unchanged.
+    public func generateNarrationStreaming(
+        text: String, voice: String?, language: String,
+        generationParameters: GenerateParameters, streamingInterval: Double,
+        onAudioChunk: @escaping (MLXArray) throws -> Void
+    ) throws -> (codecTokens: Int, expectedFrames: Int) {
+        try requireGenerationComponents()
+        guard streamingInterval.isFinite, streamingInterval >= 0.08,
+              streamingInterval <= 2 else {
+            throw AudioGenerationError.invalidInput("Invalid narration streaming interval")
+        }
+        let settings = resolveVoiceDesignGenerationSettings(
+            language: language, generationParameters: generationParameters)
+        var tokens = 0
+        _ = try generateVoiceDesign(text: text, instruct: voice, language: settings.language,
+            refAudio: nil, refText: nil, temperature: settings.temperature,
+            topK: settings.topK, topP: settings.topP,
+            repetitionPenalty: settings.repetitionPenalty, minP: settings.minP,
+            maxTokens: settings.maxTokens, streamingInterval: streamingInterval,
+            onInfo: { tokens = $0.generationTokenCount }, onAudioChunk: onAudioChunk)
+        guard narrationCompleted, tokens > 0, let speechTokenizer else {
+            throw AudioGenerationError.invalidInput("Incomplete narration generation")
         }
+        return (tokens, tokens * speechTokenizer.decodeUpsampleRate)
     }
 
