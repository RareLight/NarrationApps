+/// Model-free regression using the actual decoder layer, fixed nonzero biases,
+/// multiple strides and split sizes. Called only by the private helper probe.
+public enum QwenNarrationDecoderProof {
+    public static func run() throws -> [String: Double] {
+        var legacyMax: Float = 0, correctedMax: Float = 0, resetMax: Float = 0, zeroMax: Float = 0
+        func difference(_ a: MLXArray, _ b: MLXArray) -> Float {
+            abs(a - b).max().item(Float.self)
+        }
+        for stride in [1, 2, 4] {
+            let layer = DecoderBlockUpsample(inDim: 2, outDim: 3, upsampleRate: stride)
+            let weights = MLXArray((0..<(3 * 2 * stride * 2)).map { Float($0 % 11 - 5) / 16 }).reshaped(3, 2 * stride, 2)
+            layer.conv.update(parameters: .unflattened(["weight": weights, "bias": MLXArray([Float(0.25), -0.5, 0.75])]))
+            let input = MLXArray((0..<14).map { Float($0 - 7) / 10 }).reshaped(1, 2, 7)
+            let full = layer(input)
+            func chunks(_ corrected: Bool) -> MLXArray {
+                layer.resetState()
+                return concatenated([(0, 1), (1, 4), (4, 7)].map { start, end in
+                    layer.step(input[0..., 0..., start..<end], correctOverlapBias: corrected)
+                }, axis: -1)
+            }
+            let legacy = chunks(false), corrected = chunks(true), reset = chunks(true)
+            eval(full, legacy, corrected, reset)
+            legacyMax = max(legacyMax, difference(full, legacy))
+            correctedMax = max(correctedMax, difference(full, corrected))
+            resetMax = max(resetMax, difference(corrected, reset))
+            layer.conv.update(parameters: .unflattened(["bias": MLXArray.zeros([3])]))
+            let zeroFull = layer(input), zeroStream = chunks(true)
+            zeroMax = max(zeroMax, difference(zeroFull, zeroStream))
+        }
+        guard legacyMax > 0.1, correctedMax < 0.00001, resetMax == 0, zeroMax < 0.00001 else {
+            throw AudioGenerationError.invalidInput("Narration decoder parity regression")
+        }
+        return ["cases": 3, "legacyMaximumError": Double(legacyMax),
+            "correctedMaximumError": Double(correctedMax), "resetMaximumError": Double(resetMax),
+            "zeroBiasMaximumError": Double(zeroMax)]
+    }
+}
