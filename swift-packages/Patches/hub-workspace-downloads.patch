+    /// Disk streaming for the opt-in cache path. URLSession's serialized data
+    /// callbacks write each received buffer directly; no download task, OS
+    /// transfer file or whole-file Data allocation is involved.
+    private final class CacheDownload: NSObject, URLSessionDataDelegate, @unchecked Sendable {
+        private let configuration: URLSessionConfiguration
+        private let destination: URL
+        private let offset: Int64
+        private let progress: Progress?
+        // Only cancellation/task registration crosses the delegate queue.
+        private let lock = NSLock()
+        private var task: URLSessionDataTask?
+        private var cancelled = false
+        private var transferSession: URLSession?
+        private var continuation: CheckedContinuation<URLResponse, any Error>?
+        private var response: HTTPURLResponse?
+        private var handle: FileHandle?
+        private var failure: (any Error)?
+        private var completed: Int64 = 0
+        private var expected: Int64?
+
+        init(configuration: URLSessionConfiguration, destination: URL, offset: Int64, progress: Progress?) {
+            self.configuration = configuration; self.destination = destination
+            self.offset = offset; self.progress = progress
+        }
+
+        func receive(_ request: URLRequest) async throws -> URLResponse {
+            try Task.checkCancellation()
+            return try await withTaskCancellationHandler {
+                try await withCheckedThrowingContinuation { continuation in
+                    self.continuation = continuation
+                    let session = URLSession(configuration: configuration, delegate: self, delegateQueue: nil)
+                    transferSession = session
+                    let task = session.dataTask(with: request)
+                    lock.withLock {
+                        self.task = task
+                        if cancelled { task.cancel() }
+                    }
+                    task.resume()
+                }
+            } onCancel: {
+                self.lock.withLock { self.cancelled = true; self.task?.cancel() }
+            }
+        }
+
+        func urlSession(_ session: URLSession, dataTask: URLSessionDataTask,
+                        didReceive response: URLResponse,
+                        completionHandler: @escaping @Sendable (URLSession.ResponseDisposition) -> Void) {
+            do {
+                guard let http = response as? HTTPURLResponse else { throw URLError(.badServerResponse) }
+                self.response = http
+                // Preserve an existing partial file on HTTP failure. The Hub
+                // layer handles 416 reset and other status errors as before.
+                guard http.statusCode == 200 || http.statusCode == 206 else {
+                    completionHandler(.allow); return
+                }
+                if http.statusCode == 206 {
+                    guard let range = http.value(forHTTPHeaderField: "Content-Range"), range.hasPrefix("bytes ") else {
+                        throw URLError(.badServerResponse)
+                    }
+                    let parts = range.dropFirst(6).split(whereSeparator: { $0 == "-" || $0 == "/" })
+                    guard parts.count == 3, let start = Int64(parts[0]), let end = Int64(parts[1]),
+                          let total = Int64(parts[2]), start == offset, end >= start,
+                          total > end, end == total - 1 else { throw URLError(.badServerResponse) }
+                    completed = offset; expected = total
+                } else {
+                    // A server may ignore Range. Replace the partial prefix
+                    // with its full 200 response instead of appending it.
+                    completed = 0
+                    expected = http.expectedContentLength >= 0 ? http.expectedContentLength : nil
+                }
+                try FileManager.default.createDirectory(at: destination.deletingLastPathComponent(), withIntermediateDirectories: true)
+                let flags = O_CREAT | O_WRONLY | O_NOFOLLOW | (http.statusCode == 200 ? O_TRUNC : 0)
+                let descriptor = open(destination.path, flags, 0o600)
+                guard descriptor >= 0 else { throw NSError(domain: NSPOSIXErrorDomain, code: Int(errno)) }
+                handle = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true)
+                if http.statusCode == 206, try handle?.seekToEnd() != UInt64(offset) { throw URLError(.badServerResponse) }
+                if let expected { progress?.totalUnitCount = expected }
+                progress?.completedUnitCount = completed
+                progress?.setUserInfoObject(completed, forKey: ProgressUserInfoKey("cacheDownloadResumeOffset"))
+                completionHandler(.allow)
+            } catch {
+                failure = error
+                completionHandler(.cancel)
+            }
+        }
+
+        func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
+            guard let handle, failure == nil else { return }
+            do {
+                guard expected == nil || Int64(data.count) <= expected! - completed else { throw URLError(.badServerResponse) }
+                try handle.write(contentsOf: data)
+                completed += Int64(data.count)
+                progress?.completedUnitCount = completed
+            } catch { failure = error; dataTask.cancel() }
+        }
+
+        func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: (any Error)?) {
+            do { try handle?.synchronize(); try handle?.close() }
+            catch { if failure == nil { failure = error } }
+            handle = nil
+            let wasCancelled = lock.withLock { self.task = nil; return cancelled }
+            let result: Result<URLResponse, any Error>
+            if wasCancelled { result = .failure(CancellationError()) }
+            else if let failure = failure ?? error { result = .failure(failure) }
+            else if let expected, handleWasNeeded, completed != expected { result = .failure(URLError(.networkConnectionLost)) }
+            else if let response { result = .success(response) }
+            else { result = .failure(URLError(.badServerResponse)) }
+            continuation?.resume(with: result); continuation = nil
+            session.finishTasksAndInvalidate(); transferSession = nil
+        }
+
+        private var handleWasNeeded: Bool { response?.statusCode == 200 || response?.statusCode == 206 }
+    }
+#endif
