+    /// Explicit validated phoneme input. The caller obtained these from the
+    /// aligned frontend; ordinary user text still uses generate(text:...).
+    /// Reject unsupported scalars instead of silently dropping pronunciation.
+    public func generatePrepared(phonemes: String, voice: String, speed: Float) async throws -> MLXArray {
+        let scalars = phonemes.unicodeScalars
+        guard !scalars.isEmpty, scalars.count <= maxTokenCount,
+              speed.isFinite, speed > 0,
+              scalars.allSatisfy({ config.vocab[String($0)] != nil }) else {
+            throw AudioGenerationError.invalidInput("Invalid prepared Kokoro phonemes")
+        }
+        let tokens = scalars.map { Int32(config.vocab[String($0)]!) }
+        let embedding = try loadVoice(named: voice)
+        // Converted voice tensors preserve the reference's [510,1,256] row
+        // storage exactly. KPipeline indexes pack[len(phonemes)-1].
+        guard embedding.shape == [510, 1, 256] else {
+            throw AudioGenerationError.invalidInput("Unexpected Kokoro voice tensor")
+        }
+        let row = tokens.count - 1
+        let ids = MLXArray([Int32(0)] + tokens + [0]).reshaped([1, -1])
+        try Task.checkCancellation()
+        let (audio, _) = self.callAsFunction(inputIds: ids, refS: embedding[row..<(row + 1)], speed: speed)
+        try Task.checkCancellation()
+        return audio.reshaped([-1])
+    }
