+    /// Source-aligned frontend values for bounded native narration preparation.
+    /// Disables the optional Markdown phoneme directives: callers supply prose,
+    /// never an untrusted raw-phoneme escape hatch. No inferred alignment.
+    public struct AlignedToken: Sendable {
+        public let sourceRange: NSRange
+        public let phonemes: String
+        public let whitespace: String
+    }
+
+    public func processAligned(text: String, language: String?) throws -> [AlignedToken] {
+        let g2p = try getG2P(british: language?.lowercased().contains("gb") == true)
+        let (_, tokens) = g2p.phonemize(text: text, performPreprocess: false)
+        return tokens.map { token in
+            AlignedToken(sourceRange: NSRange(token.tokenRange, in: text),
+                         phonemes: token.phonemes ?? "❓", whitespace: token.whitespace)
+        }
+    }
+
